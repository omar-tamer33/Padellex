<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.BookingActivity">

    <ImageView
        android:id="@+id/courtImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/court"
        android:adjustViewBounds="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/weekCalendarView"
        />

    <com.kizitonwose.calendar.view.WeekCalendarView
        android:id="@+id/weekCalendarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cv_dayViewResource="@layout/calendar_day_layout"
        app:cv_scrollPaged="true"
        app:layout_constraintTop_toBottomOf="@id/courtImage"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/timeSlotRv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="3"
        tools:listitem="@layout/item_time_slot"
        app:layout_constraintTop_toBottomOf="@id/weekCalendarView"
        app:layout_constraintBottom_toTopOf="@id/cardView"
        />

    <Button
        android:id="@+id/mapBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="see location on map"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/courtImage"
        />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:cardCornerRadius="26dp"
        app:contentPadding="12dp"
        >

        <TextView
            android:id="@+id/priceCalcTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_0_0_egp"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_gravity="start"
            />

        <Button
            android:id="@+id/bookBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_gravity="end"
            />

    </androidx.cardview.widget.CardView>



</androidx.constraintlayout.widget.ConstraintLayout>