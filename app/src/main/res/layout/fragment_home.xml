<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/bg_color"
    android:layout_margin="10dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.35"
        android:backgroundTint="@color/bg_color"
        app:layout_constraintTop_toTopOf="parent"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profile_image"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/blank_profile_picture"
                app:layout_constraintVertical_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="22dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toTopOf="@id/yourSkillsTv"
                />

            <TextView
                android:id="@+id/helloTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="@id/profile_image"
                app:layout_constraintStart_toEndOf="@id/profile_image"
                android:text="@string/hello"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:layout_margin="8dp"
                />

            <TextView
                android:id="@+id/userNameTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/helloTv"
                app:layout_constraintStart_toEndOf="@id/profile_image"
                tools:text="Omar Tamer"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:layout_marginStart="8dp"
                />

            <TextView
                android:id="@+id/yourSkillsTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/your_skills"
                android:textColor="@color/purple"
                android:textStyle="bold"
                android:textSize="22sp"
                app:layout_constraintTop_toBottomOf="@id/profile_image"
                app:layout_constraintStart_toStartOf="@id/profile_image"
                app:layout_constraintBottom_toTopOf="@id/playStyleTv"
                />

            <TextView
                android:id="@+id/reviewSkillsTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/review_skill"
                android:textColor="@color/gray"
                android:layout_margin="15dp"
                app:layout_constraintBottom_toBottomOf="@id/yourSkillsTv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/yourSkillsTv"
                />

            <TextView
                android:id="@+id/playStyleTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintWidth_percent="0.4"
                tools:text="Defensive\nPLAYSTYLE"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_medium"
                android:textAlignment="center"
                android:layout_marginBottom="5dp"
                android:textSize="22sp"
                app:layout_constraintTop_toBottomOf="@id/yourSkillsTv"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/speedTv"
                />

            <View
                android:layout_width="2dp"
                android:layout_height="0dp"
                android:background="@color/gray"
                android:layout_marginVertical="15dp"
                app:layout_constraintTop_toTopOf="@id/playStyleTv"
                app:layout_constraintBottom_toBottomOf="@id/playStyleTv"
                app:layout_constraintStart_toEndOf="@id/playStyleTv"
                app:layout_constraintEnd_toStartOf="@id/speedTv"
                />

            <TextView
                android:id="@+id/speedTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintWidth_percent="0.3"
                tools:text="50\nSpeed"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_medium"
                android:textAlignment="center"
                android:layout_marginBottom="5dp"
                android:textSize="22sp"
                app:layout_constraintTop_toTopOf="@id/playStyleTv"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/playStyleTv"
                app:layout_constraintEnd_toStartOf="@id/powerTv"
                />

            <View
                android:layout_width="2dp"
                android:layout_height="0dp"
                android:background="@color/gray"
                android:layout_marginVertical="15dp"
                app:layout_constraintTop_toTopOf="@id/speedTv"
                app:layout_constraintBottom_toBottomOf="@id/speedTv"
                app:layout_constraintStart_toEndOf="@id/speedTv"
                app:layout_constraintEnd_toStartOf="@id/powerTv"
                />

            <TextView
                android:id="@+id/powerTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintWidth_percent="0.3"
                tools:text="70\nPower"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_medium"
                android:textAlignment="center"
                android:layout_marginBottom="5dp"
                android:textSize="22sp"
                app:layout_constraintTop_toTopOf="@id/speedTv"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/speedTv"
                app:layout_constraintEnd_toEndOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>